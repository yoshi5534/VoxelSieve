# Scale benchmark: runs the command-line tools on phantoms of growing size and collects time,
# peak memory and reads per tool from their telemetry (ADR 0017) into a CSV file. With LIMITS it
# also checks the peaks and brick re-reads against recorded values (the `scale` tests).
#
#   cmake -DBIN=build/release/bin -DWORK=/tmp/vs-scale [-DSIZES=256;512;1024] [-DSTEPS=...]
#         [-DLIMITS=tests/scale_limits.json] [-DRECORD=tests/scale_limits.json] [-DKEEP_INPUT=ON]
#         [-DTOOL_ARGS=--memory;8192]
#         -P tools/bench/scale.cmake
#
# BIN    directory of the tools (vs-phantom, vs-sieve, ...)
# WORK   scratch directory; every size gets WORK/<size>, cleared at the start. A phantom of N^3
#        voxels takes 2 N^3 bytes (16 GiB at 2048), the dataset about a third of that.
# SIZES  voxels per axis, a ;-list (default 256;512)
# STEPS  tools to run after phantom and sieve, a ;-list of porosity surface segment thickness
#        thicknessmap compare report denoise (default: all). Thickness, compare and report run
#        the surface first.
# CSV    result file (default WORK/scale.csv): one row per size and tool
# LIMITS limits file: fails when a peak or a re-read factor is more than 20 % above the value
#        recorded for this platform, thread count and size; steps without a record pass
# RECORD writes the measured values into this limits file (created or updated)
# KEEP_INPUT keeps the phantom's raw file after the sieve
# TOOL_ARGS options for every tool, a ;-list, such as --memory;8192 (the memory budget, ADR 0034)
#
# Columns: own_peak_mb is the peak of the process's own resident memory, mapped_peak_mb that of
# mapped file pages, which the system can drop at any time; brick_reread is the brick files loaded
# divided by the size of level 0 on disk (1 = each brick of full resolution once).
cmake_minimum_required(VERSION 3.21)

foreach(required BIN WORK)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "Set -D${required}=... (see the head of ${CMAKE_CURRENT_LIST_FILE})")
  endif()
endforeach()
get_filename_component(BIN "${BIN}" ABSOLUTE)
get_filename_component(WORK "${WORK}" ABSOLUTE)
get_filename_component(SOURCE "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(NOT DEFINED SIZES)
  set(SIZES 256 512)
endif()
if(NOT DEFINED STEPS)
  set(STEPS porosity surface segment thickness thicknessmap compare report denoise)
endif()
if(NOT DEFINED CSV)
  set(CSV "${WORK}/scale.csv")
endif()
set(exe "")
if(EXISTS "${BIN}/vs-sieve.exe")
  set(exe ".exe")
endif()
if(NOT EXISTS "${BIN}/vs-sieve${exe}")
  message(FATAL_ERROR "No vs-sieve in ${BIN}")
endif()
foreach(step thickness thicknessmap compare report)
  if(step IN_LIST STEPS AND NOT "surface" IN_LIST STEPS)
    list(PREPEND STEPS surface)
  endif()
endforeach()

# A decimal number as an integer number of tenths ("183533.1" -> 1835331).
function(to_tenths out value)
  if(value MATCHES "^([0-9]+)(\\.([0-9]))?")
    set(fraction "${CMAKE_MATCH_3}")
    if(fraction STREQUAL "")
      set(fraction 0)
    endif()
    math(EXPR tenths "${CMAKE_MATCH_1} * 10 + ${fraction}")
  else()
    set(tenths 0)
  endif()
  set(${out} ${tenths} PARENT_SCOPE)
endfunction()

# A number of the telemetry with at most two decimals (CMake prints doubles in full).
function(trim out value)
  if(value MATCHES "^([0-9]+)(\\.([0-9]*))?$")
    set(whole "${CMAKE_MATCH_1}")
    string(SUBSTRING "${CMAKE_MATCH_3}000" 0 3 fraction)
    # Rounded to hundredths; the leading 1 keeps math() from reading "050" oddly.
    math(EXPR hundredths "(${whole} * 1000 + 1${fraction} - 1000 + 5) / 10")
    ratio(value ${hundredths} 100)
  endif()
  set(${out} "${value}" PARENT_SCOPE)
endfunction()

# n / d with two decimals, both integers.
function(ratio out n d)
  if(d LESS_EQUAL 0)
    set(${out} "" PARENT_SCOPE)
    return()
  endif()
  math(EXPR hundredths "(${n} * 100 + ${d} / 2) / ${d}")
  math(EXPR whole "${hundredths} / 100")
  math(EXPR rest "${hundredths} % 100")
  if(rest LESS 10)
    set(rest "0${rest}")
  endif()
  set(${out} "${whole}.${rest}" PARENT_SCOPE)
endfunction()

# Total bytes of the files under a directory, in tenths of a MB.
function(directory_tenths_mb out dir)
  file(GLOB_RECURSE files "${dir}/*")
  set(bytes 0)
  foreach(f IN LISTS files)
    file(SIZE "${f}" size)
    math(EXPR bytes "${bytes} + ${size}")
  endforeach()
  math(EXPR tenths "${bytes} * 10 / 1048576")
  set(${out} ${tenths} PARENT_SCOPE)
endfunction()

# The phantom spans 12.8 mm at every size, so the part keeps its share of the volume: voxel size
# 12.8 / N mm, written with nine decimals.
function(voxel_size out n)
  math(EXPR nanometres "12800000000 / ${n}")
  math(EXPR whole "${nanometres} / 1000000000")
  math(EXPR rest "${nanometres} % 1000000000")
  string(LENGTH "${rest}" digits)
  while(digits LESS 9)
    set(rest "0${rest}")
    math(EXPR digits "${digits} + 1")
  endwhile()
  set(${out} "${whole}.${rest}" PARENT_SCOPE)
endfunction()

file(MAKE_DIRECTORY "${WORK}")
file(WRITE "${CSV}"
     "size,step,exit,wall_s,cores_used,own_peak_mb,mapped_peak_mb,rss_peak_mb,read_mb,"
     "mapped_read_mb,brick_read_mb,brick_reread,disk_read_mb,disk_write_mb,level0_mb,threads,"
     "memory_split\n")
set(failures "")
set(platform "")
set(measured "")  # entries "size|step|own_peak_tenths|reread" for the limits

# Runs one tool, appends its row to the CSV and records the values for the limits.
macro(run_step step)
  set(telemetry "${dir}/${step}.telemetry.json")
  message(STATUS "[${n}^3] ${step}")
  execute_process(COMMAND "${BIN}/${tool}${exe}" ${arguments} ${TOOL_ARGS} --telemetry "${telemetry}"
                  RESULT_VARIABLE result OUTPUT_FILE "${dir}/${step}.log" ERROR_FILE "${dir}/${step}.log")
  set(row "${n},${step},${result}")
  if(result EQUAL 0 AND EXISTS "${telemetry}")
    file(READ "${telemetry}" record)
    string(JSON threads GET "${record}" system threads)
    string(JSON split ERROR_VARIABLE no_split GET "${record}" system memory_split)
    if(no_split)
      set(split "")
    endif()
    foreach(field wall_s cores_used peak_anon_mb peak_file_mb peak_rss_mb read_mb mapped_read_mb
                  brick_read_mb)
      string(JSON ${field} ERROR_VARIABLE missing GET "${record}" total ${field})
      if(missing)
        set(${field} "")
      endif()
    endforeach()
    string(JSON disk_read_mb GET "${record}" total disk_read_mb)
    string(JSON disk_write_mb GET "${record}" total disk_write_mb)
    to_tenths(own_tenths "${peak_anon_mb}")
    to_tenths(brick_tenths "${brick_read_mb}")
    ratio(reread ${brick_tenths} ${level0_tenths})
    ratio(level0_mb ${level0_tenths} 10)
    if(level0_tenths EQUAL 0)
      set(reread "")
      set(level0_mb "")
    endif()
    foreach(field wall_s cores_used peak_anon_mb peak_file_mb peak_rss_mb read_mb mapped_read_mb
                  brick_read_mb disk_read_mb disk_write_mb)
      trim(${field} "${${field}}")
    endforeach()
    string(APPEND row ",${wall_s},${cores_used},${peak_anon_mb},${peak_file_mb},${peak_rss_mb}"
           ",${read_mb},${mapped_read_mb},${brick_read_mb},${reread},${disk_read_mb}"
           ",${disk_write_mb},${level0_mb},${threads},${split}")
    string(TOLOWER "${CMAKE_HOST_SYSTEM_NAME}" os)
    set(platform "${os}-${threads}t")
    list(APPEND measured "${n}|${step}|${own_tenths}|${reread}")
  else()
    string(APPEND row ",,,,,,,,,,,,,,")
    list(APPEND failures "${n}^3 ${step} (exit ${result}, see ${dir}/${step}.log)")
  endif()
  file(APPEND "${CSV}" "${row}\n")
endmacro()

foreach(n IN LISTS SIZES)
  set(dir "${WORK}/${n}")
  file(REMOVE_RECURSE "${dir}")
  file(MAKE_DIRECTORY "${dir}")
  set(level0_tenths 0)
  voxel_size(pitch ${n})

  set(tool vs-phantom)
  set(arguments --out "${dir}/phantom" --dims ${n} --voxel-size ${pitch})
  run_step(phantom)
  set(tool vs-sieve)
  set(arguments "${dir}/phantom.raw" --out "${dir}/dataset")
  run_step(sieve)
  if(NOT result EQUAL 0)
    continue()
  endif()
  if(NOT KEEP_INPUT)
    file(REMOVE "${dir}/phantom.raw")
  endif()
  directory_tenths_mb(level0_tenths "${dir}/dataset/level0")

  foreach(step IN LISTS STEPS)
    set(arguments "${dir}/dataset" --out "${dir}/${step}")
    if(step STREQUAL "porosity")
      set(tool vs-porosity)
    elseif(step STREQUAL "surface")
      set(tool vs-surface)
      set(arguments "${dir}/dataset" --out "${dir}/surface.vss")
    elseif(step STREQUAL "segment")
      set(tool vs-segment)
    elseif(step STREQUAL "thickness")
      set(tool vs-thickness)
      list(APPEND arguments --surface "${dir}/surface.vss")
    elseif(step STREQUAL "thicknessmap")
      set(tool vs-thickness)
      list(APPEND arguments --surface "${dir}/surface.vss" --volume-map)
    elseif(step STREQUAL "compare")
      # The CAD model: the phantom's 8 mm box.
      if(NOT EXISTS "${WORK}/box.stl")
        execute_process(COMMAND "${BIN}/vs-synth${exe}" --box 8 8 8 --voxel-size 0.5 --noise 0
                                --stl "${WORK}/box.stl" --out "${WORK}/box"
                        RESULT_VARIABLE synth OUTPUT_QUIET ERROR_QUIET)
        if(NOT synth EQUAL 0)
          message(FATAL_ERROR "vs-synth failed to write the CAD box")
        endif()
      endif()
      set(tool vs-compare)
      set(arguments "${dir}/surface.vss" "${WORK}/box.stl" --out "${dir}/compare")
    elseif(step STREQUAL "report")
      set(tool vs-report)
      list(APPEND arguments --order "${SOURCE}/examples/inspection_order.json"
           --surface "${dir}/surface.vss")
    elseif(step STREQUAL "denoise")
      set(tool vs-denoise)
    else()
      message(FATAL_ERROR "Unknown step ${step}")
    endif()
    run_step(${step})
  endforeach()
endforeach()
message(STATUS "Results: ${CSV}")

# Limits: own peak memory and brick re-reads at most 20 % above the recorded values.
if(DEFINED LIMITS AND EXISTS "${LIMITS}")
  file(READ "${LIMITS}" limits)
  set(exceeded "")
  foreach(entry IN LISTS measured)
    string(REPLACE "|" ";" parts "${entry}")
    list(GET parts 0 n)
    list(GET parts 1 step)
    list(GET parts 2 own_tenths)
    list(GET parts 3 reread)
    string(JSON limit_own ERROR_VARIABLE none GET "${limits}" "${platform}" "${n}" "${step}"
           own_peak_mb)
    if(none)
      message(STATUS "[${n}^3] ${step}: no limit recorded for ${platform}")
      continue()
    endif()
    to_tenths(limit_tenths "${limit_own}")
    math(EXPR allowed "${limit_tenths} * 12 / 10")
    if(own_tenths GREATER allowed)
      ratio(own_mb ${own_tenths} 10)
      list(APPEND exceeded "${n}^3 ${step}: own peak ${own_mb} MB, recorded ${limit_own} MB")
    endif()
    string(JSON limit_reread ERROR_VARIABLE none GET "${limits}" "${platform}" "${n}" "${step}"
           brick_reread)
    if(NOT none AND NOT reread STREQUAL "")
      to_tenths(reread_tenths "${reread}")
      to_tenths(limit_tenths "${limit_reread}")
      math(EXPR allowed "${limit_tenths} * 12 / 10 + 1")
      if(reread_tenths GREATER allowed)
        list(APPEND exceeded "${n}^3 ${step}: brick re-read ${reread}, recorded ${limit_reread}")
      endif()
    endif()
  endforeach()
  if(exceeded)
    list(JOIN exceeded "\n  " text)
    list(APPEND failures "above the limits (+20 %):\n  ${text}")
  endif()
endif()

if(DEFINED RECORD AND measured)
  set(record "{}")
  if(EXISTS "${RECORD}")
    file(READ "${RECORD}" record)
  endif()
  foreach(entry IN LISTS measured)
    string(REPLACE "|" ";" parts "${entry}")
    list(GET parts 0 n)
    list(GET parts 1 step)
    list(GET parts 2 own_tenths)
    list(GET parts 3 reread)
    string(JSON ignored ERROR_VARIABLE none GET "${record}" "${platform}")
    if(none)
      string(JSON record SET "${record}" "${platform}" "{}")
    endif()
    string(JSON ignored ERROR_VARIABLE none GET "${record}" "${platform}" "${n}")
    if(none)
      string(JSON record SET "${record}" "${platform}" "${n}" "{}")
    endif()
    ratio(own_mb ${own_tenths} 10)
    set(values "{\"own_peak_mb\": ${own_mb}}")
    if(NOT reread STREQUAL "")
      set(values "{\"own_peak_mb\": ${own_mb}, \"brick_reread\": ${reread}}")
    endif()
    string(JSON record SET "${record}" "${platform}" "${n}" "${step}" "${values}")
  endforeach()
  # Written by hand, one line per tool: string(JSON) prints doubles in full and spreads every
  # value over several lines.
  set(text "{\n")
  string(JSON platforms LENGTH "${record}")
  foreach(ip RANGE 1 ${platforms})
    math(EXPR i "${ip} - 1")
    string(JSON name MEMBER "${record}" ${i})
    string(APPEND text "  \"${name}\": {\n")
    string(JSON sizes LENGTH "${record}" "${name}")
    foreach(is RANGE 1 ${sizes})
      math(EXPR i "${is} - 1")
      string(JSON size MEMBER "${record}" "${name}" ${i})
      string(APPEND text "    \"${size}\": {\n")
      string(JSON steps LENGTH "${record}" "${name}" "${size}")
      foreach(it RANGE 1 ${steps})
        math(EXPR i "${it} - 1")
        string(JSON step MEMBER "${record}" "${name}" "${size}" ${i})
        string(JSON own GET "${record}" "${name}" "${size}" "${step}" own_peak_mb)
        trim(own "${own}")
        set(line "\"own_peak_mb\": ${own}")
        string(JSON reread ERROR_VARIABLE none GET "${record}" "${name}" "${size}" "${step}"
               brick_reread)
        if(NOT none)
          trim(reread "${reread}")
          string(APPEND line ", \"brick_reread\": ${reread}")
        endif()
        set(comma ",")
        if(it EQUAL steps)
          set(comma "")
        endif()
        string(APPEND text "      \"${step}\": {${line}}${comma}\n")
      endforeach()
      set(comma ",")
      if(is EQUAL sizes)
        set(comma "")
      endif()
      string(APPEND text "    }${comma}\n")
    endforeach()
    set(comma ",")
    if(ip EQUAL platforms)
      set(comma "")
    endif()
    string(APPEND text "  }${comma}\n")
  endforeach()
  string(APPEND text "}\n")
  file(WRITE "${RECORD}" "${text}")
  message(STATUS "Recorded ${platform} into ${RECORD}")
endif()

if(failures)
  list(JOIN failures "\n" text)
  message(FATAL_ERROR "${text}")
endif()
