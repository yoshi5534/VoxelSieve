<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Makes UTF-8 the code page of VoxelSieve's programs (Windows 10 1903 and later), so paths in
     std::string, the JSON API and the command line are UTF-8 as on Linux and macOS. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
